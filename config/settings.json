{
  "start_mode": "HYBRID",
  "listen_mode": "WAKE_WORD",
  "speech_model": "SMALL",
  "wake_word": "hand",
  "command_window_seconds": 5,
  "push_to_talk_key": "ctrl_r",
  "resume_hotkey": "ctrl+alt+r",
  "microphone_device": null,
  "camera_index": 0,
  "camera_fps": 12,
  "camera_width": 640,
  "camera_height": 360,
  "gestures_enabled": true,
  "face_wink_style": "TABS",
  "face_hold_seconds": 0.5,
  "face_swap_eyes": false,
  "hand": "Any",
  "min_hand_confidence": 0.7,
  "stable_frames": 5,
  "default_hold_seconds": 1.0,
  "sleep_hold_seconds": 2.0,
  "scroll_hold_seconds": 0.3,
  "cooldown_seconds": 1.0,
  "movement_tolerance": 0.15,
  "scroll_notch_interval_ms": 80,
  "volume_tick_interval_ms": 150,
  "switch_window_timeout_seconds": 8,
  "browser_mode_timeout_seconds": 10,
  "confirmation_timeout_seconds": 5,
  "sleep_countdown_seconds": 3,
  "fuzzy_threshold": 85,
  "picker_gap": 5,
  "file_open_threshold": 85,
  "file_open_gap": 10,
  "index_folders": ["Documents", "Desktop", "Downloads", "Projects"],
  "index_extensions": ["pdf", "docx", "xlsx", "pptx", "txt", "py", "html", "png", "jpg", "jpeg", "md", "csv"],
  "index_refresh_minutes": 30,
  "log_level": "INFO",
  "show_indicators": true
}
